# GS Phone Directory — root Apache config.
#
# Goal: keep everything private EXCEPT the public phonebook.xml that the
# Grandstream phones download. The /data and /includes directories also carry
# their own deny-all .htaccess as defence in depth.

# Serve the generated phonebook with the correct content type.
<IfModule mod_mime.c>
    AddType text/xml .xml
</IfModule>

# Block direct download of the JSON "database" and source includes, in case
# this app is installed somewhere the per-directory rules are not honoured.
<FilesMatch "\.(json|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Do not expose the directory listing.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
